{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L2 Static Source Review",
  "type": "object",
  "required": [
    "repository",
    "commit",
    "skill_path",
    "review_level",
    "disposition",
    "tree_truncated",
    "files_indexed",
    "files_selected",
    "files_read",
    "file_kind_counts",
    "file_evidence",
    "mechanism_findings",
    "review_errors",
    "capability_claims_not_runtime_verified",
    "runtime_tested",
    "source_code_executed",
    "limitations",
    "reviewed_at"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "skill_path": {
      "type": "string",
      "minLength": 1
    },
    "review_level": {
      "const": "L2"
    },
    "disposition": {
      "enum": [
        "BLOCKED",
        "L2_STATIC_REVIEW_COMPLETE"
      ]
    },
    "tree_truncated": {
      "type": "boolean"
    },
    "files_indexed": {
      "type": "integer",
      "minimum": 0
    },
    "files_selected": {
      "type": "integer",
      "minimum": 0
    },
    "files_read": {
      "type": "integer",
      "minimum": 0
    },
    "file_kind_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "file_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "read"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "mechanism_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "code",
          "occurrences",
          "line_numbers"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1
          },
          "line_numbers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "review_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "error"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "capability_claims_not_runtime_verified": {
      "const": true
    },
    "runtime_tested": {
      "const": false
    },
    "source_code_executed": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
